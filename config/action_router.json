{
  "schema_version": 1,
  "intent_gate": {
    "trigger_probability": 0.95,
    "release_probability": 0.75,
    "consecutive_frames": 3,
    "cooldown_ms": 1500
  },
  "ollama": {
    "enabled": true,
    "url": "http://127.0.0.1:11434/api/chat",
    "model": "llama3.2:3b",
    "timeout_seconds": 5.0
  },
  "actions": {
    "noop": {"handler": "noop", "aliases": []},
    "click_left": {"handler": "mouse_click_left", "aliases": ["k l i k l i n k s","klick links","click left"]},
    "click_right": {"handler": "mouse_click_right", "aliases": ["k l i k r e ch t s","klick rechts","click right"]},
    "cursor_center": {"handler": "mouse_center", "aliases": ["m i t e","mitte","center cursor"]},
    "vector_left": {"handler": "vector_pulse", "vector": [-0.35,0.0,0.0,0.0], "duration_ms": 120, "aliases": ["l i n k s","links","move left"]},
    "vector_right": {"handler": "vector_pulse", "vector": [0.35,0.0,0.0,0.0], "duration_ms": 120, "aliases": ["r e ch t s","rechts","move right"]},
    "vector_up": {"handler": "vector_pulse", "vector": [0.0,-0.35,0.0,0.0], "duration_ms": 120, "aliases": ["h o ch","hoch","move up"]},
    "vector_down": {"handler": "vector_pulse", "vector": [0.0,0.35,0.0,0.0], "duration_ms": 120, "aliases": ["r u n t e r","runter","move down"]},
    "grip": {"handler": "vector_pulse", "vector": [0.0,0.0,0.0,0.8], "duration_ms": 150, "aliases": ["g r a i f e n","greifen","grip"]},
    "robot_stop": {"handler": "robot_stop", "aliases": ["s t o p","stop","halt"]},
    "dashboard_open": {"handler": "open_dashboard", "aliases": ["d a sh b o r d","dashboard","open dashboard"]},
    "lock_interface": {"handler": "lock_interface", "aliases": ["s p e r e n","sperren","lock interface"]}
  }
}